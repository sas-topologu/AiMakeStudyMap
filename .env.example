# 知识星图 · 生产环境变量示例
# 复制为 .env 或直接在启动/PM2 环境里设置。生产必须设 STARMAP_SECRET！
# 说明：index.js 用 process.env.PORT；app.js 用 process.env.STARMAP_SECRET；
#       connection.js 用 process.env.STARMAP_DB（默认 server/data/starmap.db）。

# 必填（安全）—— 改成随机长字符串
STARMAP_SECRET=请改成一串很长的随机字符

# 可选
PORT=3000
# STARMAP_DB=/absolute/path/to/starmap.db   # 默认 server/data/starmap.db
# NODE_ENV=production

# 邮件（找回密码真实发送，可选；不配则验证码走服务端控制台+留档）
# 本项目 sendMail 默认仅 console；要真实发信需自行装 nodemailer 并替换实现，
# 或在 tools/management-ai 中配置相应发送。
