{
  "name": "zhidian-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "智点星谱 · 手机客户端（Capacitor：把 web 客户端打包为 Android App）",
  "scripts": {
    "prepare:www": "node -e \"const fs=require('fs');const p=require('path');fs.rmSync('www',{recursive:true,force:true});fs.cpSync(p.join('..','web','dist'),'www',{recursive:true})\"",
    "add:android": "cap add android",
    "sync": "cap sync android",
    "apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
